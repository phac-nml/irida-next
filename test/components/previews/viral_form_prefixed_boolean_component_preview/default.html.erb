<%= form_with url: '#' do |form| %>
  <%= render Viral::Form::Prefixed::BooleanComponent.new(form: form, name: "prefixed" , value: true) do |checkbox| %>
    <%= checkbox.with_legend do %>
      This is the group legend
    <% end %>

    <%= checkbox.with_prefix do %>
      --prefix
    <% end %>
  <% end %>
<% end %>
