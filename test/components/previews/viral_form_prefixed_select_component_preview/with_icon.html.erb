<%= form_with url: '#' do |form| %>
  <%= render Viral::Form::Prefixed::SelectComponent.new(form:, name: "prefixed-select", options: [['Lisbon', 1], ['Madrid', 2]]) do |select| %>
    <%= select.with_prefix do %>
      <%= icon(:warning_circle, size: :sm, color: :warning) %>
    <% end %>
  <% end %>
<% end %>
