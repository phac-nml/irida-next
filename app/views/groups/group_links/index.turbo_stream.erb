<%= turbo_stream.update "invited_groups", method: "morph", partial: "invited_groups", locals: { namespace_group_links: @namespace_group_links, namespace: @namespace, access_levels: @access_levels, q: @q, has_group_links: @has_group_links, allowed_to: @allowed_to, pagy: @pagy } %>

<%= turbo_stream.update "invited_groups_pagination",
                    method: "morph",
                    partial: "pagination",
                    locals: { has_group_links: @has_group_links, pagy: @pagy } %>

<%= turbo_stream.update "new_group_link_dialog",
                    partial: "invite_group_modal",
                    locals: {
                      access_levels: @access_levels,
                      namespace: @namespace,
                      namespace_linkable_groups: @namespace_linkable_groups,
                      new_group_link: @new_group_link,
                      open: false,
                      tab: "invited_groups",
                    } %>

<%= turbo_stream.update "new_member_dialog",
                    partial: "groups/members/create_modal",
                    locals: {
                      open: false,
                      tab: "invited_groups",
                    } %>
