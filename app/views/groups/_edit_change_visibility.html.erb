<%# locals: (group:) %>

<%= render Viral::CardComponent.new do |card| %>
  <% card.with_header(title: t("groups.edit.advanced.change_visibility.title")) %>

  <% card.with_section do %>
    <%= form_with(model: group, url: group_path, method: :patch, data: { controller: "visibility-form", action: "submit->visibility-form#updateConfirmationWarning", visibility_form_current_value: group.public?.to_s, turbo_confirm: "", turbo_content: ".confirm-change-visibility", confirm_value: group.path }, html: { novalidate: true }) do |form| %>
      <div>
        <div class="confirm-change-visibility hidden">
          <div class="mb-4 flex rounded-lg bg-red-50 p-4 text-red-800 dark:bg-slate-800 dark:text-red-400">
            <%= icon(:warning_circle) %>

            <span class="ml-4 flex-1">
              <span data-visibility-form-target="publicWarning">
                <%= t("groups.edit.advanced.change_visibility.confirm.public.warning_html", group_name: group.human_name) %>
              </span>

              <span class="hidden" data-visibility-form-target="privateWarning">
                <%= t("groups.edit.advanced.change_visibility.confirm.private.warning_html", group_name: group.human_name) %>
              </span>
            </span>
          </div>

          <div class="mb-4">
            <% t("groups.edit.advanced.change_visibility.confirm.points_html", group: group.path).each do |item| %>
              <p class="mb-2 text-base text-slate-900 dark:text-white"><%= item %></p>
            <% end %>
          </div>
        </div>
      </div>

      <p class="mb-4 text-base text-slate-900 dark:text-white">
        <% if group.public? %>
          <%= t("groups.edit.advanced.change_visibility.description.public") %>
        <% else %>
          <%= t("groups.edit.advanced.change_visibility.description.private") %>
        <% end %>
      </p>

      <%= render partial: "visibility_form", locals: { form: form, group: group } %>

      <div>
        <%= form.submit t("groups.edit.advanced.change_visibility.submit"), tone: :primary,
                            emphasis: :solid, disabled: true,
                            data: { visibility_form_target: "submit" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
