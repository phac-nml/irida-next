<%# locals: (allowed_to: @allowed_to, attachments:, has_attachments:, namespace:, pagy:, q:, render_individual_attachments:, results_message: @results_message, search:, search_url:) -%>

<% attachments_advanced_search = Flipper.enabled?(:attachments_advanced_search) %>

<% if attachments_advanced_search %>
  <div role="status" class="sr-only"><%= results_message %></div>

  <%= form_with model: search, html: { role: "search", class: "mb-2 flex justify-end gap-2" }, scope: :q, url: search_url, method: :get,
    data: { turbo_action: 'replace', controller: 'filters', "filters-selection-outlet": "#attachments-table" } do |form| %>
    <% if q.present? && !q.sorts.empty? %>
      <%= hidden_field_tag "q[s]", "#{q.sorts.first.name} #{q.sorts.first.dir}" %>
    <% end %>

    <%= hidden_field_tag :limit, pagy.limit %>
    <%= hidden_field_tag :tab, "files" %>

    <div class="max-sm:grow">
      <%= render SearchFieldComponent.new(
      form: form,
      field_name: :puid_or_file_blob_filename_cont,
      label: t("common.controls.search"),
      placeholder: t("workflow_executions.files.search.placeholder"),
      value: search.puid_or_file_blob_filename_cont,
      include_advanced_search_outlet: true,
      data: {
        "search-field-selection-outlet": "#attachments-table",
      },
      classes: "sm:min-w-[20rem]"
    ) %>
    </div>

    <div class="max-sm:grow">
      <%= render AdvancedSearchComponent.new(
        form: form,
        search: search,
        fields: AdvancedSearch::Fields.for_attachments,
        open: search.errors.any?,
        status: search.advanced_query?,
      ) %>
    </div>
  <% end %>
<% end %>

<%= render Attachments::TableComponent.new(
  attachments,
  pagy,
  q,
  namespace,
  render_individual_attachments,
  has_attachments,
  sort_replaces_history: true,
  abilities: {
    # Uncomment when ready to use multi-select functionality
    # select_attachments: allowed_to?(:destroy_attachment?, namespace)
  },
  row_actions: {
    preview: allowed_to[:preview_attachment],
    destroy: allowed_to[:destroy_attachment],
  },
  empty: {
    icon_name: Attachment.icon,
    title: t(:".empty.title"),
    description: t(:".empty.description"),
  },
) %>
