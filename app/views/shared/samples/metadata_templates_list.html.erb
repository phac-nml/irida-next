<%= turbo_frame_tag "metadata-template-dd-menu" do %>
  <%= form_with url: @url, method: :post,
data: {
  turbo_stream: true,
} do |f| %>
    <%= f.hidden_field :format, value: "turbo_stream" %>
    <%= f.hidden_field :limit, value: @limit %>
    <%= f.hidden_field :page, value: @page %>

    <ul
      id="metadata_templates_dropdown"
      class="py-2 text-sm text-slate-700 dark:text-slate-200"
      aria-labelledby="metadata-template-dd-trigger"
      role="menu"
    >
      <li
        class="
          w-full bg-slate-200 px-3 py-2 text-xs font-bold tracking-wider text-slate-700 uppercase dark:bg-slate-700
          dark:text-slate-200
        "
        role="none"
      >
        <%= t("shared.samples.metadata_templates.fields.label") %>
      </li>

      <%= render partial: "shared/samples/metadata_template_item",
      locals: {
        selected: @current_metadata_template_id == "all",
        name: t("shared.samples.metadata_templates.fields.all"),
        value: "all",
      } %>

      <%= render partial: "shared/samples/metadata_template_item",
      locals: {
        selected: @current_metadata_template_id == "none",
        name: t("shared.samples.metadata_templates.fields.none"),
        value: "none",
      } %>

      <%- if @metadata_templates.any? %>
        <li
          class="
            w-full bg-slate-200 px-3 py-2 text-xs font-bold tracking-wider text-slate-700 uppercase
            dark:bg-slate-700 dark:text-slate-200
          "
          role="none"
        >
          <%= t("shared.samples.metadata_templates.templates.label") %>
        </li>
        <% @metadata_templates.each do |metadata_template| %>
          <%= render partial: "shared/samples/metadata_template_item",
          locals: {
            selected: @current_metadata_template_id == metadata_template.id,
            name: metadata_template.name,
            value: metadata_template.id,
          } %>
        <% end %>
      <% end %>
    </ul>
  <% end %>
<% end %>
