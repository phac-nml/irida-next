<%# locals: (column_count:) -%>

<% 4.times do %>
  <tr class="animate-pulse">
    <% column_count.times do %>
      <td class="py-2">
        <div class="mb-2 h-4 w-1/2 rounded-sm bg-gray-200"></div>
        <div class="h-3 w-2/3 rounded-sm bg-gray-200"></div>
      </td>
    <% end %>
  </tr>
<% end %>
