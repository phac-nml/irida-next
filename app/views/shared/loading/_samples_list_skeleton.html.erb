<%# locals: () %>

<div role="status" class="max-w-sm animate-pulse">
  <% 4.times do %>
    <div class="py-1">
      <div class="mb-2 h-4 w-1/2 rounded-sm bg-gray-200"></div>
      <div class="h-3 w-2/3 rounded-sm bg-gray-200"></div>
    </div>
  <% end %>

  <span class="sr-only"><%= t(:".loading") %></span>
</div>
