<%# locals: () %>

<div role="status" class="animate-pulse">
  <% widths = [24, 32, 40, 48, 64] %>

  <% 4.times do %>
    <% width_class = "w-#{widths.sample}" %>

    <div class="mb-6">
      <div class="mb-2 h-3 rounded-sm bg-slate-200 dark:bg-slate-700 <%= width_class %>"></div>
      <div class="h-8 w-full rounded-sm bg-slate-200 dark:bg-slate-700"></div>
    </div>
  <% end %>

  <div class="mt-8 flex items-center">
    <div class="me-3 h-10 w-36 rounded-sm bg-slate-200 dark:bg-slate-700"></div>
    <div class="h-10 w-28 rounded-sm bg-slate-200 dark:bg-slate-700"></div>
  </div>

  <span class="sr-only"><%= t(:".loading") %></span>
</div>
