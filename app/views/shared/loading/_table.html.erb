<%# locals: () %>

<table class="min-w-full table-fixed dark:divide-slate-600">
  <tbody class="divide-y divide-slate-200 bg-white dark:divide-slate-700 dark:bg-slate-800">
    <% 10.times do %>
      <tr>
        <td class="animate-pulse p-4">
          <div class="flex-1 space-y-6 py-1">
            <div class="space-y-3">
              <div class="h-2 w-48 rounded-sm bg-slate-200"></div>
              <div class="h-2 w-32 rounded-sm bg-slate-200"></div>
            </div>
          </div>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
