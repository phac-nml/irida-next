<%# locals: (page:, attachments:) -%>

<% if page == 1 %>
  <%= turbo_stream.replace "list_selections" do %>
    <tbody id="list_selections"></tbody>
  <% end %>
<% end %>

<%= turbo_stream.append("list_selections") do %>
  <%= render partial: "shared/attachments/list_attachment", collection: attachments, as: :attachment %>
<% end %>
