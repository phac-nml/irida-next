<div class="flex items-center py-2">
  <div class="items-centers flex font-sans">
    <div>
      <div class="flex items-center">
        <% if attachment.associated_attachment && attachment.metadata['direction'] == 'forward' %>
          <%= icon(:arrow_right, size: :sm, class: "ml-0 mr-2") %>
        <% elsif attachment.associated_attachment %>
          <%= icon(:arrow_left, size: :sm, class: "ml-0 mr-2") %>
        <% else %>
          <%= icon(Attachment.icon, size: :sm, class: "ml-0 mr-2") %>
        <% end %>

        <span class="font-normal text-slate-800 dark:text-slate-100">
          <%= attachment.file.filename.to_s %>
          <%= render PuidComponent.new(puid: attachment.puid, show_clipboard: false) %>
        </span>
      </div>
    </div>
  </div>
</div>
