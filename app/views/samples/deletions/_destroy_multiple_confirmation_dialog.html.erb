<%# locals: (sample_deletion_form: @sample_deletion_form, namespace: @namespace, open:) %>

<% sample_deletion_reason_enabled = Flipper.enabled?(:sample_deletion_reason, current_user) %>

<%= render Viral::DialogComponent.new(id: "multiple-deletions-dialog", open: open) do |dialog| %>
  <% dialog.with_header(title: t(".title")) %>

  <div
    data-controller="infinite-scroll"
    data-infinite-scroll-selection-outlet="#samples-table"
    data-infinite-scroll-paged-field-name-value="sample_ids[]"
    data-infinite-scroll-singular-description-value="<%= t(".description.singular") %>"
    data-infinite-scroll-plural-description-value="<%= t(".description.plural") %>"
  >
    <%= form_with(
        url: list_samples_path(list_class: 'sample'),
        data: { "infinite-scroll-target": "pageForm" }
      ) do %>
      <div data-infinite-scroll-target="pageFormContent"></div>
    <% end %>

    <div class="grid gap-4">
      <p data-infinite-scroll-target="summary" class="text-base leading-relaxed text-slate-500 dark:text-slate-400">
        <%= t(".description.zero") %>
      </p>

      <div>
        <div class="mb-1 block text-sm font-medium text-slate-900 dark:text-white"><%= t(".samples") %></div>

        <div
          class="
            block max-h-[300px] w-full overflow-y-auto rounded-lg border border-slate-300 p-2.5
            dark:border-slate-600 dark:bg-slate-800
          "
          data-action="scroll->infinite-scroll#scroll"
          data-infinite-scroll-target="scrollable"
        >
          <%= turbo_frame_tag "list_selections" do %>
            <%= render partial: "shared/loading/samples_list_skeleton" %>
          <% end %>
        </div>
      </div>

      <%= form_for(sample_deletion_form || :deletion, as: :deletion,
            url: samples_deletions_path(namespace_id: namespace.id),
            data: {
              controller: "spinner form--json-submission",
              "form--json-submission-selection-outlet": '#samples-table',
              "form--json-submission-field-name-value": "deletion[sample_ids][]",
              "form--json-submission-clear-selection-value": "true",
              "form--json-submission-target": "form",
              action:"turbo:submit-start->spinner#submitStart turbo:submit-end->viral--dialog#close",
              turbo_frame: "_top"
            }
          ) do |form| %>
        <%= hidden_field_tag :deletion_type, params[:deletion_type] %>

        <div class="grid gap-4">
          <% if sample_deletion_reason_enabled %>
            <%= form_error_summary(form) %>

            <%= render partial: "shared/form/required_field_legend" %>

            <% invalid_reason = sample_deletion_form.errors.include?(:reason) %>

            <div class="form-field <%= 'invalid' if invalid_reason %>">
              <%= form.label :reason, data: { required: true } %>

              <% aria_describedby = invalid_reason ? form.field_id(:reason, "error") : nil %>

              <%= form.text_area :reason,
              {
                rows: 3,
                maxlength: 500,
                class: "form-control",
                placeholder: t("samples.deletions.reason_placeholder"),
                "aria-describedby" => aria_describedby,
                "aria-invalid" => invalid_reason,
              } %>

              <% if invalid_reason %>
                <%= render "shared/form/field_errors",
                  id: form.field_id(:reason, "error"),
                  errors: sample_deletion_form.errors.full_messages_for(:reason) %>
              <% end %>
            </div>
          <% end %>

          <div>
            <%= form.submit t(".submit_button"),
                          tone: :danger,
                          emphasis: :solid,
                          data: {
                            "spinner-target": "submit",
                            "turbo-submits-with": t(:".loading"),
                          } %>
          </div>
        </div>
      <% end %>
    </div>

    <div
      role="status"
      id="spinner"
      class="
        absolute top-2/4 left-1/2 grid hidden h-full w-full -translate-x-1/2 -translate-y-1/2 place-items-center
        backdrop-blur-sm
      "
    >
      <div class="grid place-items-center">
        <%= icon :faded_spinner, library: "animated" %>
        <span class="text-black dark:text-white"><%= t(:".spinner") %>.</span>
      </div>
    </div>
  </div>
<% end %>
