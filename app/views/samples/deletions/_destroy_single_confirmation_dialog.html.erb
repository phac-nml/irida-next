<%# locals: (sample_deletion_form: @sample_deletion_form, namespace: @namespace, open:, sample: @sample) %>

<% sample_deletion_reason_enabled = Flipper.enabled?(:sample_deletion_reason, current_user) %>

<%= render Viral::DialogComponent.new(open: open, size: :large) do |dialog| %>
  <% dialog.with_header(title: t(".title")) %>
  <%= turbo_frame_tag("deletion-alert") %>

  <div
    data-controller="selection"
    data-selection-storage-key-value="<%= request.base_url %><%= namespace_project_samples_path(namespace.parent, namespace.project) %>"
    class="mb-4 overflow-x-visible font-normal text-slate-500 dark:text-slate-400"
  >
    <p class="mb-4">
      <%= t(".description", sample_name: sample.name) %>
    </p>

    <%= form_for(sample_deletion_form || :deletion, as: :deletion,
            url: samples_deletions_path(namespace_id: namespace.id, 'destroy[sample_ids]': [sample.id]),
            data: {
              turbo_frame: "_top",
            }
          ) do |form| %>
      <%= hidden_field_tag :deletion_type, params[:deletion_type] %>
      <%= hidden_field_tag :sample_id, params[:sample_id] %>
      <%= hidden_field_tag "deletion[sample_ids][]", sample.id %>

      <div class="grid gap-4">
        <% if sample_deletion_reason_enabled %>
          <%= form_error_summary(form) %>

          <%= render partial: "shared/form/required_field_legend" %>

          <% invalid_reason = sample_deletion_form.errors.include?(:reason) %>

          <div class="form-field <%= 'invalid' if invalid_reason %>">
            <%= form.label :reason, data: { required: true } %>

            <% aria_describedby = invalid_reason ? form.field_id(:reason, "error") : nil %>

            <%= form.text_area :reason,
                {
                  :rows => 3,
                  :maxlength => 500,
                  :class => "form-control",
                  :placeholder => t("samples.deletions.reason_placeholder"),
                  "aria-describedby" => aria_describedby,
                  "aria-invalid" => invalid_reason,
                } %>

            <% if invalid_reason %>
              <%= render "shared/form/field_errors",
                id: form.field_id(:reason, "error"),
                errors: sample_deletion_form.errors.full_messages_for(:reason) %>
            <% end %>
          </div>
        <% end %>

        <div>
          <%= form.submit t('common.actions.remove'),
                          tone: :danger,
                          emphasis: :solid,
                          data: {
                            action: "click->selection#remove",
                            "selection-id-param": sample.id,
                          } %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
