<!DOCTYPE html>

<html class="light" lang="<%= locale %>">
  <%= render "layouts/partials/head" %>

  <body class="auth-shell min-h-dvh overflow-auto bg-[var(--pvc-color-surface)] text-[var(--pvc-color-text)]">
    <div class="flex min-h-dvh" data-turbo="false">
      <div class="flex min-w-0 flex-1 flex-col lg:max-w-[32.5rem]">
        <header class="flex items-center justify-between gap-4 px-4 py-3 lg:px-16 lg:pt-8 lg:pb-0">
          <span class="flex items-center gap-2 font-semibold">
            <%= icon(
              :beaker,
              library: :heroicons,
              size: :lg,
              color: nil,
              class: "rotate-12 text-[var(--pvc-color-accent)]",
            ) %>

            <%= t("devise.layout.title") %>
          </span>

          <div class="flex-none">
            <%= render DropdownComponent.new(icon: :translate, label: t(:"locales.#{locale}", locale: locale), aria: { label: I18n.t(:'layouts.application.language_selection.aria_label')}) do |dropdown| %>
              <%- I18n.available_locales.each do |locale| %>
                <%= dropdown.with_item(
                  label: t(:"locales.#{locale}", locale: locale),
                  url: url_for(locale: locale, **params.to_unsafe_h.except(:locale)),
                  lang: locale,
                  hreflang: locale,
                ) %>
              <%- end %>
            <% end %>
          </div>
        </header>

        <div
          class="
            h-[5.625rem] flex-none overflow-hidden border-y border-[var(--pvc-color-border)] bg-slate-50 lg:hidden
            dark:bg-slate-950 forced-colors:hidden [@media(max-height:32rem)]:hidden
          "
        >
          <%= render "devise/shared/art", classes: "h-full w-full object-none object-[-190px_-530px]" %>
        </div>

        <main class="my-auto w-full px-4 py-6 lg:px-16 lg:py-12">
          <div class="mx-auto w-full max-w-[24.5rem] lg:mx-0">
            <% if content_for?(:auth_title) %>
              <%= render Pathogen::Typography::Heading.new(level: 1) do %>
                <%= content_for(:auth_title) %>
              <% end %>
            <% end %>

            <% if content_for?(:auth_description) %>
              <p class="mt-2 text-[var(--pvc-color-text-muted)]"><%= content_for(:auth_description) %></p>
            <% end %>

            <div class="mt-6 space-y-6">
              <% auth_flash_messages.each do |type, message| %>
                <%= render "devise/shared/alert", type: type do %>
                  <%= message %>
                <% end %>
              <% end %>

              <div><%= yield %></div>
            </div>
          </div>
        </main>
      </div>

      <aside
        class="
          relative hidden min-w-0 flex-1 overflow-hidden border-l border-[var(--pvc-color-border)] bg-slate-50
          lg:block dark:bg-slate-950 forced-colors:hidden
        "
      >
        <%= render "devise/shared/art", classes: "absolute inset-0 h-full w-full object-none object-left-top" %>

        <p
          class="
            absolute bottom-6 left-6 rounded-[var(--pvc-radius-control)] border border-[var(--pvc-color-border)]
            bg-slate-50 px-2 py-1 text-xs text-[var(--pvc-color-text-muted)] dark:bg-slate-950
          "
        >
          <%= t("devise.layout.art_caption") %>
        </p>
      </aside>
    </div>
  </body>
</html>
