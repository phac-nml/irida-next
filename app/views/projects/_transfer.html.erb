<%# locals: (authorized_namespaces:, project:, transfer_form:) %>

<div class="confirm-transfer hidden">
  <div class="mb-4 flex rounded-lg bg-red-50 p-4 text-red-800 dark:bg-slate-800 dark:text-red-400">
    <%= icon(:warning_circle, color: :danger) %>

    <span class="ml-4 flex-1">
      <%= t(
        "projects.edit.advanced.transfer.confirm.warning_html",
        project_name: project.human_name,
      ) %>
    </span>
  </div>

  <div class="mb-4">
    <% t("projects.edit.advanced.transfer.confirm.points_html", project: project.name).each do |item| %>
      <p class="mb-2 text-base text-slate-900 dark:text-white"><%= item %></p>
    <% end %>
  </div>
</div>

<div class="grid gap-3 p-4">
  <div>
    <h3 class="text-[length:var(--type-control)] font-semibold text-[var(--pvc-color-text)]">
      <%= t("projects.edit.advanced.transfer.title") %>
    </h3>

    <%= render Pathogen::Typography::Supporting.new(variant: :muted, tag: :p) do %>
      <%= t("projects.edit.advanced.transfer.description") %>
    <% end %>
  </div>

  <ul class="ml-5 list-outside list-disc space-y-1 text-[length:var(--type-control)] text-[var(--pvc-color-text-muted)]">
    <% t("projects.edit.advanced.transfer.points").each do |item| %>
      <li><%= item %></li>
    <% end %>
  </ul>

  <%= render "projects/transfer_form",
    authorized_namespaces: authorized_namespaces,
    project: project,
    transfer_form: transfer_form %>
</div>
