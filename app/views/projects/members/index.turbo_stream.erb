<% if @tab != "invited_groups" %>
  <%= turbo_stream.update "members", method: "morph", partial: "member_listing", locals: {
    q: @q,
    has_members: @has_members,
    pagy: @pagy,
    members: @members,
    access_levels: @access_levels,
    allowed_to: @allowed_to,
    namespace: @namespace,
    current_user: @current_user
  } %>

  <%= turbo_stream.update "members_pagination", method: "morph", partial: "pagination", locals: { has_members: @has_members, pagy: @pagy } %>
<% end %>

<%= turbo_stream.update "new_group_link_dialog",
                    partial: "projects/group_links/invite_group_modal",
                    locals: {
                      access_levels: @access_levels,
                      namespace: @namespace,
                      namespace_linkable_groups: @namespace_linkable_groups,
                      new_group_link: @new_group_link,
                      open: false,
                      tab: @tab,
                    } %>

<%= turbo_stream.update "new_member_dialog",
                    partial: "create_modal",
                    locals: {
                      open: false,
                      tab: @tab,
                      access_levels: @access_levels,
                      available_users: @available_users,
                      namespace: @namespace,
                      new_member: @new_member
                    } %>
