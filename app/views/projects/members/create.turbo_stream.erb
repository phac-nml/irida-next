<%= turbo_stream.update "new_member_dialog",
                    partial: "create_modal",
                    locals: {
                      access_levels: @access_levels,
                      available_users: @available_users,
                      open: member.errors.any? ? true : false,
                      namespace: @namespace,
                      new_member: @new_member,
                      tab: @tab,
                    } %>

<% if @new_member.persisted? %>
  <%= turbo_stream.append "flashes" do %>
    <%= render Viral::FlashComponent.new(type:, data: message) %>
  <% end %>

  <%= turbo_stream.replace "members" do %>
    <%= turbo_frame_tag "members", src: namespace_project_members_path(@namespace.parent, @namespace.project, format: :turbo_stream) do %>
      <%= render partial: "shared/loading/table" %>
    <% end %>
  <% end %>
<% end %>
