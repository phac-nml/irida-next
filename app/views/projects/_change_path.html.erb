<%# locals: (project:) -%>

<%= form_with(model: project,
              url: namespace_project_path,
              method: :patch,
              html: { novalidate: true },
              class: "grid gap-4",
              data: { controller: "projects--path-preview" }) do |form| %>
  <%= form.fields_for :namespace, include_id: false do |builder| %>
    <%= form_error_summary(builder, include: %i[path]) %>

    <% invalid_path = project.namespace.errors.include?(:path) %>

    <p
      id="<%= builder.field_id(:path, "warning") %>"
      class="
        flex max-w-xl items-start gap-2 text-[length:var(--type-control)] font-medium
        text-[var(--pvc-color-warning-strong)]
      "
    >
      <%= icon(:warning_circle, class: "shrink-0") %>
      <span><%= t(:"projects.edit.advanced.path.description") %></span>
    </p>

    <div class="form-field max-w-xl <%= 'invalid' if invalid_path %>">
      <%= builder.label :path, data: { required: true } %>

      <%= builder.text_field :path,
                         pattern: Irida::PathRegex::PATH_REGEX_STR,
                         required: true,
                         data: {
                           "projects--path-preview-target": "input",
                           action: "input->projects--path-preview#update",
                         },
                         aria: {
                           describedby: [
                             builder.field_id(:path, "warning"),
                             invalid_path ? builder.field_id(:path, "error") : nil,
                             builder.field_id(:path, "preview"),
                             builder.field_id(:path, "hint"),
                           ].compact.join(" "),
                           invalid: invalid_path,
                           required: true,
                         } %>

      <% if invalid_path %>
        <%= render "shared/form/field_errors",
        id: builder.field_id(:path, "error"),
        errors: project.namespace.errors.full_messages_for(:path) %>
      <% end %>

      <p
        id="<%= builder.field_id(:path, "preview") %>"
        class="mt-1 text-[length:var(--type-meta)] wrap-anywhere text-[var(--pvc-color-text-muted)]"
      >
        <%= t(:"projects.edit.advanced.path.preview_label") %>
        <%= root_url %><%= project.parent.full_path %>/<strong class="font-semibold text-[var(--pvc-color-text)]" data-projects--path-preview-target="path"><%= project.namespace.path %></strong>
      </p>

      <span id="<%= builder.field_id(:path, "hint") %>" class="field-hint">
        <%== t(:"projects.edit.advanced.path.help") %>
      </span>
    </div>

    <div>
      <%= form.submit t(:"projects.edit.advanced.path.submit"),
                  data: { turbo_frame: "_top" },
                  tone: :neutral,
                  emphasis: :outline,
                  class: "inline-block" %>
    </div>
  <% end %>
<% end %>
