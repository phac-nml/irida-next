<%= turbo_stream.update "table-filter", partial: "table_filter", locals: { pagy: @pagy, query: @query, search_params: @search_params, results_message: @results_message, advanced_search_fields: @advanced_search_fields } %>

<% if @query.valid? %>
  <%= turbo_stream.append "samples-table" do %>
    <%= render SpinnerComponent.new(message: t("projects.samples.table_filter.loading")) %>
  <% end %>

  <turbo-stream action="refresh"></turbo-stream>
<% end %>
