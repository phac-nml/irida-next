<% if @automated_workflow_execution.disabled %>
  <%= turbo_stream.append "flashes" do %>
    <%= render Viral::FlashComponent.new(type:, data: message) %>
  <% end %>
<% else %>
  <%= turbo_stream.update(
    "automated_workflow_execution_modal",
    partial: "edit_dialog",
    locals: {
      open: true,
      automated_workflow_execution: @automated_workflow_execution,
      workflow: @workflow,
      project: @project
    },
  ) %>
<% end %>
