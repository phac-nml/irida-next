<%= render Viral::DialogComponent.new(
  id: "trigger_automated_workflow_execution_dialog",
  size: :large,
  open: true
) do |dialog| %>
  <% dialog.with_header(title: t(".title")) %>

  <div class="space-y-6">
    <div class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <dl class="space-y-3">
        <div class="flex justify-between">
          <dt class="font-semibold text-gray-700"><%= t(".name") %></dt>

          <dd class="text-gray-900">
            <%= automated_workflow_execution.name.presence || automated_workflow_execution.id %>
          </dd>
        </div>

        <div class="flex justify-between">
          <dt class="font-semibold text-gray-700"><%= t(".workflow_name") %></dt>
          <dd class="text-gray-900"><%= automated_workflow_execution.workflow.name %></dd>
        </div>

        <div class="flex justify-between">
          <dt class="font-semibold text-gray-700"><%= t(".version") %></dt>
          <dd class="text-gray-900"><%= automated_workflow_execution.metadata["workflow_version"] %></dd>
        </div>
      </dl>
    </div>

    <div>
      <h3 class="mb-4 text-sm font-semibold text-gray-900"><%= t(".search_form_title") %></h3>

      <% advanced_search_form = AdvancedSearchFormComponent.new(
        form: nil,
        search: query,
        fields: advanced_search_fields,
      ) %>

      <%= form_with model: query, html: { role: "search" }, scope: :q, url: launch_namespace_project_automated_workflow_execution_path(
        @project.parent,
        @project,
        automated_workflow_execution
      ), method: :post, data: {
        turbo_action: 'replace',
        controller: "form--json-submission",
        "form--json-submission-target": "form",
      }, local: true do |f| %>
        <%= tag.div(
          id: "advanced-search",
          data: {
            controller: "advanced-search--v1",
            "advanced-search--v1-has-errors-value": query.errors.any?,
            "advanced-search--v1-list-input-outlet": ".list-input",
            "advanced-search--v1-enum-fields-value": json_escape_data(advanced_search_fields.fetch(:enum_fields, {})),
            "advanced-search--v1-enum-operations-value": json_escape_data(advanced_search_form.enum_operations),
            "advanced-search--v1-operations-value": json_escape_data(advanced_search_form.operations),
          },
        ) do %>
          <%= render AdvancedSearchFormComponent.new(
            form: f,
            search: query,
            fields: advanced_search_fields,
          ) %>
        <% end %>

        <div class="mt-6 flex gap-3">
          <%= render Viral::ButtonComponent.new(
            data: { action: "viral--dialog#close" }
          ) do %>
            <%= t("common.actions.cancel") %>
          <% end %>

          <%= f.submit t("common.actions.trigger"),
            class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
