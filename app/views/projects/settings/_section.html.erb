<%# locals: (title:, heading_id:, description: nil, danger: false) -%>

<section
  aria-labelledby="<%= heading_id %>"
  class="
    grid gap-x-10 gap-y-4 border-t border-[var(--pvc-color-border)] py-6 first:border-t-0 first:pt-0
    md:grid-cols-[minmax(0,15rem)_1fr]
  "
>
  <div class="space-y-1">
    <h2
      id="<%= heading_id %>"
      class="
        text-[length:var(--type-section)] leading-snug font-semibold
        <%= danger ? 'text-[var(--pvc-color-danger-strong)]' : 'text-[var(--pvc-color-text)]' %>
      "
    >
      <%= title %>
    </h2>

    <% if description.present? %>
      <%= render Pathogen::Typography::Supporting.new(variant: :muted, tag: :p) do %>
        <%= description %>
      <% end %>
    <% end %>
  </div>

  <div class="min-w-0">
    <%= yield %>
  </div>
</section>
