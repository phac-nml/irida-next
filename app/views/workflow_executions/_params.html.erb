<%# locals: (workflow_execution:, workflow:) %>

<% workflow.workflow_params.each do |_item, definition| %>
  <% definition[:properties].each do |name, property| %>
    <% unless %[input].include? name.to_s %>
      <div class="mb-4">
        <p class="mb-1 text-sm font-medium text-slate-900 dark:text-white"><%= property[:description] %></p>

        <div
          class="
            mb-2 flex flex-col rounded-lg border border-slate-300 bg-slate-300 @md:flex-row dark:border-slate-600
            dark:bg-slate-600
          "
        >
          <span
            class="
              inline-flex items-center rounded-t-lg px-3 py-2 font-mono text-sm text-slate-900 @md:rounded-l-lg
              @md:rounded-tr-none dark:text-slate-300
            "
          >
            --<%= name %>
          </span>

          <input
            type="text"
            disabled
            class="
              block w-full min-w-0 flex-1 rounded-b-lg border-none bg-slate-50 p-2.5 text-sm text-slate-900
              focus-visible:z-10 @md:rounded-r-lg @md:rounded-bl-none dark:bg-slate-700 dark:text-white
              dark:placeholder-slate-400
            "
            value="<%= formatted_workflow_param(property, workflow_execution.workflow_params[name.to_s]) %>"
          >
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
