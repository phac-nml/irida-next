<% contents = @attachment.file.download %>

<div class="hidden" data-copy-target="source">
  <%= contents %>
</div>

<div class="mb-4 rounded-lg bg-slate-50 p-4 text-sm text-slate-800 dark:bg-slate-800 dark:text-slate-300" role="alert">
  <div class="font-mono">
    <% contents.lines.each_with_index do |line, index| %>
      <div class="flex">
        <span
          class="
            w-12 border-r border-slate-200 pr-2 text-right text-slate-400 select-none dark:border-slate-700
            dark:text-slate-500
          "
        >
          <%= index + 1 %>
        </span>

        <span class="pl-4"><%= line.strip %></span>
      </div>
    <% end %>
  </div>
</div>
