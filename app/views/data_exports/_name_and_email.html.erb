<%# locals: (form:) %>

<% if Flipper.enabled?(:data_export_custom_basename, Current.user) %>
  <div data-controller="slugify">
    <div class="form-field">
      <%= form.label :name, t(:"data_exports.new.name_label") %>

      <%= form.text_field :name,
                          data: {
                            "slugify-target": "name",
                            action: "input->slugify#nameChanged",
                          },
                          class: "form-control" %>
    </div>

    <% invalid_basename = form.object.errors.include?(:basename) %>

    <div class="form-field mt-2 <%= 'invalid' if invalid_basename %>">
      <%= form.label :basename, t(:"data_exports.new.basename_label") %>

      <%= form.text_field :basename,
                    title: t(:"data_exports.new.basename_help"),
                    data: { "slugify-target": "path" },
                    aria: {
                      describedby: [
                        invalid_basename ? form.field_id(:basename, "error") : nil,
                        form.field_id(:basename, "hint"),
                      ].join(" "),
                      invalid: invalid_basename,
                    },
                    class: "form-control" %>

      <%= render "shared/form/field_errors",
      id: form.field_id(:basename, "error"),
      errors: form.object.errors.full_messages_for(:basename) %>

      <span id="<%= form.field_id(:basename, "hint") %>" class="field-hint">
        <%= t(:"data_exports.new.basename_help") %>
      </span>
    </div>
  </div>
<% else %>
  <div class="form-field mt-2">
    <%= form.label :name, t(:"data_exports.new.name_label") %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
<% end %>

<div class="mt-2 flex items-center">
  <%= form.check_box :email_notification, { checked: false }, true, false %>

  <%= form.label :email_notification,
             t(:"data_exports.new.email_label"),
             class: "mr-2 text-sm font-medium text-slate-900 dark:text-white" %>
</div>
