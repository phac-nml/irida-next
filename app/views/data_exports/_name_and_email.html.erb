<%# locals: (form:) %>

<div class="form-field mt-2">
  <%= form.label :name, t(:"data_exports.new.name_label") %>

  <%= form.text_field :name,
                maxlength: 100,
                pattern: /^[\w\-]*$/,
                title: t(:"data_exports.new.name_help"),
                aria: { describedby: form.field_id(:name, "hint") },
                class: "form-control" %>

  <span id="<%= form.field_id(:name, "hint") %>" class="field-hint">
    <%= t(:"data_exports.new.name_help") %>
  </span>
</div>

<div class="flex h-5 items-center">
  <%= form.check_box :email_notification, { checked: false }, true, false %>

  <%= form.label :email_notification,
             t(:"data_exports.new.email_label"),
             class: "mr-2 text-sm font-medium text-slate-900 dark:text-white" %>
</div>
