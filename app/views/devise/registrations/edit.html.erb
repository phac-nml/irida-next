<% content_for :auth_title, t(".title", resource_name: resource_name.to_s.humanize) %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-4", novalidate: true }) do |f| %>
  <%= render "devise/shared/error_summary", entries: FormErrorSummaryEntryBuilder.new(builder: f).call %>

  <div><%= render partial: "shared/form/required_field_legend" %></div>

  <%= render "devise/shared/hidden_locale_input", form: f %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :email,
  field: :email_field,
  mark_required: true,
  input: {
    autofocus: resource.errors.none?,
    autocomplete: "email",
  } %>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <p class="text-sm"><%= t(".confirmation_message", email: resource.unconfirmed_email) %></p>
  <% end %>

  <% length_hint = t(".password_length_hint", minimum_password_length: @minimum_password_length) if @minimum_password_length %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password,
  field: :password_field,
  mark_required: true,
  toggle: true,
  hint: [t(".password_blank_hint"), length_hint].compact.join(" "),
  input: {
    autocomplete: "new-password",
  } %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password_confirmation,
  field: :password_field,
  mark_required: true,
  input: {
    autocomplete: "new-password",
  } %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :current_password,
  field: :password_field,
  mark_required: true,
  hint: t(".current_password_hint"),
  input: {
    autocomplete: "current-password",
  } %>

  <%= f.submit t('common.actions.update'), tone: :primary, emphasis: :solid, block: true %>
<% end %>

<div class="mt-6 space-y-2 border-t border-[var(--pvc-color-border)] pt-6">
  <%= render Pathogen::Typography::Heading.new(level: 2) do %>
    <%= t(".cancel_title") %>
  <% end %>

  <p class="text-sm text-[var(--pvc-color-text-muted)]"><%= t(".unhappy") %></p>

  <%= pathogen_button_to t(".cancel_button"),
    registration_path(resource_name),
    method: :delete,
    tone: :neutral,
    emphasis: :outline,
    form: {
      data: {
        turbo: true,
      },
    },
    data: {
      turbo: true,
      turbo_confirm: t(".cancel_confirmation"),
    } %>
</div>

<p class="mt-4 text-sm">
  <%= render Pathogen::Link.new(href: url_for(:back)) do %>
    <%= t(".back_link") %>
  <% end %>
</p>

<%= render ConfirmationComponent.new %>
