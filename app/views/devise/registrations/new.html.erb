<% content_for :auth_title, t(".title") %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4", novalidate: true }) do |f| %>
  <%= render "devise/shared/error_summary", entries: FormErrorSummaryEntryBuilder.new(builder: f).call %>

  <div><%= render partial: "shared/form/required_field_legend" %></div>

  <%= render "devise/shared/hidden_locale_input", form: f %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :email,
  field: :email_field,
  mark_required: true,
  input: {
    autofocus: resource.errors.none?,
    autocomplete: "email",
  } %>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= render "devise/shared/field",
    form: f,
    attribute: :first_name,
    mark_required: true,
    input: {
      autocomplete: "given-name",
    } %>

    <%= render "devise/shared/field",
    form: f,
    attribute: :last_name,
    mark_required: true,
    input: {
      autocomplete: "family-name",
    } %>
  </div>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password,
  field: :password_field,
  mark_required: true,
  toggle: true,
  hint: (t(".password_hint", minimum_password_length: @minimum_password_length) if @minimum_password_length),
  input: {
    autocomplete: "new-password",
  } %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password_confirmation,
  field: :password_field,
  mark_required: true,
  input: {
    autocomplete: "new-password",
  } %>

  <%= f.submit t(".submit_button"), tone: :primary, emphasis: :solid, block: true %>
<% end %>

<p class="mt-6 border-t border-[var(--pvc-color-border)] pt-6 text-sm text-[var(--pvc-color-text-muted)]">
  <%= t(".signed_up") %>

  <%= render Pathogen::Link.new(href: new_session_path(resource_name, **auth_locale_params)) do %>
    <%= t("devise.shared.links.sign_in_link") %>
  <% end %>
</p>
