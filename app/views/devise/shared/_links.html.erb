<%# locals: () %>

<div class="mt-6 grid gap-2 border-t border-(--pvc-color-border) pt-6 text-sm">
  <%- if controller_name != 'sessions' %>
    <span>
      <%= render Pathogen::Link.new(href: new_session_path(resource_name, **auth_locale_params)) do %>
        <%= t(".sign_in_link") %>
      <% end %>
    </span>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <span class="text-(--pvc-color-text-muted)">
      <%= t(".create_an_account") %>

      <%= render Pathogen::Link.new(href: new_registration_path(resource_name, **auth_locale_params)) do %>
        <%= t(".create_an_account_link") %>
      <% end %>
    </span>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <span>
      <%= render Pathogen::Link.new(href: new_confirmation_path(resource_name, **auth_locale_params)) do %>
        <%= t(".confirmation_link") %>
      <% end %>
    </span>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <span>
      <%= render Pathogen::Link.new(href: new_unlock_path(resource_name, **auth_locale_params)) do %>
        <%= t(".unlock_link") %>
      <% end %>
    </span>
  <% end %>
</div>
