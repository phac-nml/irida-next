<%# locals: (resource:) %>

<% if resource.errors.any? %>
  <div
    class="
      flex items-center border-l-4 border-red-300 bg-red-50 p-4 text-red-800 dark:border-red-800 dark:bg-slate-800
      dark:text-red-400
    "
    role="alert"
  >
    <div>
      <span class="font-semibold">
        <%= I18n.t(
          "errors.template.header",
          count: resource.errors.count,
          model: resource.class.model_name.human.downcase,
        ) %>
      </span>

      <ul class="mt-1.5 max-h-60 list-inside list-disc space-y-3 overflow-y-auto p-1 md:max-h-80">
        <% resource.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
