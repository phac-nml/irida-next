<%# locals: () -%>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", novalidate: true }) do |f| %>
  <%= render "devise/shared/hidden_locale_input" %>

  <input type="hidden" name="local" value="<%= params[:local] %>">

  <%= render "devise/shared/field",
  form: f,
  attribute: :email,
  field: :email_field,
  input: {
    autofocus: true,
    autocomplete: "email",
  } %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password,
  field: :password_field,
  toggle: true,
  input: {
    autocomplete: "current-password",
  } %>

  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <% if devise_mapping.rememberable? %>
      <div class="flex min-h-11 items-center">
        <%= f.check_box :remember_me, class: "!mt-0" %>
        <%= f.label :remember_me, class: "!mb-0 py-3" %>
      </div>
    <% end %>

    <% if devise_mapping.recoverable? %>
      <span class="text-sm">
        <%= render Pathogen::Link.new(href: new_password_path(resource_name, **auth_locale_params)) do %>
          <%= t("devise.shared.links.forgot_password_link") %>
        <% end %>
      </span>
    <% end %>
  </div>

  <%= f.submit t(".sign_in"), tone: :primary, emphasis: :solid, block: true %>
<% end %>
