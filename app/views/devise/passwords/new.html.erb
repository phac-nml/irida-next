<% content_for :auth_title, t(".title") %>
<% content_for :auth_description, t(".description") %>

<div
  data-controller="email-input"
  data-email-input-email-missing-value="<%= t('devise.passwords.new.email.required_error') %>"
  data-email-input-email-format-value="<%= t('devise.passwords.new.email.format_error') %>"
>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), data: {
    email_input_target: "form",
    action: "submit->email-input#submit"
    }, html: { method: :post, class: "space-y-4", novalidate: true }) do |f| %>
    <% if resource.errors.any? %>
      <%= render "devise/shared/error_summary", entries: FormErrorSummaryEntryBuilder.new(builder: f).call %>
    <% else %>
      <%= render "devise/shared/error_summary",
      hidden: true,
      data: { email_input_target: "summary" },
      entries: [
        FormErrorSummaryEntryBuilder::Entry.new(
          attribute: :email,
          message: t("devise.passwords.new.email.required_error"),
          target_id: f.field_id(:email),
        ),
      ] %>
    <% end %>

    <%= render "devise/shared/hidden_locale_input" %>

    <%= render "devise/shared/field",
    form: f,
    attribute: :email,
    field: :email_field,
    input: {
      autofocus: resource.errors.none?,
      autocomplete: "email",
      data: {
        email_input_target: "emailField",
        action: "input->email-input#handleInput",
      },
    } %>

    <%# Client-side errors land here. The server's own error owns the id when there is one. %>
    <%= tag.ul id: (f.field_id(:email, "error") unless resource.errors.include?(:email)),
               class: "hidden",
               data: { email_input_target: "errorContainer" } do %>
      <%= render "devise/shared/field_error", message: "" %>
    <% end %>

    <%= f.submit t(".submit_button"), tone: :primary, emphasis: :solid, block: true %>
  <% end %>
</div>

<%= render "devise/shared/links" %>
