<% content_for :auth_title, t(".title") %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4", novalidate: true }) do |f| %>
  <%= render "devise/shared/error_summary", entries: FormErrorSummaryEntryBuilder.new(builder: f).call %>

  <%= render "devise/shared/hidden_locale_input" %>

  <%= f.hidden_field :reset_password_token %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password,
  field: :password_field,
  label_text: t(".password_label"),
  toggle: true,
  hint: (t(".password_hint", minimum_password_length: @minimum_password_length) if @minimum_password_length),
  input: {
    autofocus: resource.errors.none?,
    autocomplete: "new-password",
  } %>

  <%= render "devise/shared/field",
  form: f,
  attribute: :password_confirmation,
  field: :password_field,
  label_text: t(".password_confirmation_label"),
  input: {
    autocomplete: "new-password",
  } %>

  <%= f.submit t(".submit_button"), tone: :primary, emphasis: :solid, block: true %>
<% end %>

<%= render "devise/shared/links" %>
