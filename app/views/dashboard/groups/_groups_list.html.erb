<%# locals: (q:, pagy:, has_groups:, tab:, groups:, render_flat_list:, empty_title: t("dashboard.groups.index.no_groups_title"), empty_description: t("dashboard.groups.index.no_groups_description")) %>

<div class="flex flex-col">
  <div class="mb-2 flex flex-wrap justify-end gap-2">
    <% if has_groups %>
      <%= render SearchComponent.new(
          query: q,
          url: dashboard_groups_url(**request.query_parameters),
          search_attribute: :name_or_puid_cont,
          label: t("common.controls.search"),
          placeholder: t('dashboard.groups.index.search.placeholder'),
          total_count: pagy.count,
          class: "max-sm:grow",
          value: q.name_or_puid_cont,
          data: {},
          as: (params[:public] == 'true' ? :public_groups_q : :all_groups_q)
        ) do %>
        <% if params[:public] == 'true' %>
          <input type="hidden" name="public" value="true">
        <% end %>
      <% end %>
      <%= render Ransack::SortDropdownComponent.new(
      q,
      "groups",
      [
        { name: "updated_at", dir: "desc" },
        { name: "updated_at", dir: "asc" },
        { name: "name", dir: "asc" },
        { name: "name", dir: "desc" },
        { name: "created_at", dir: "desc" },
        { name: "created_at", dir: "asc" },
      ],
      turbo: false,
    ) %>
    <% end %>
  </div>

  <% if has_groups %>
    <div class="flex flex-col gap-2" id="groups_tree">
      <%= render TreegridComponent.new(aria: {label: t("dashboard.groups.treegrid.aria_label.#{tab}")}) do |component| %>
        <% groups.each_with_index do |group, group_index| %>
          <%= component.with_row(tabindex: (group_index.zero? ? 0 : -1), expandable: !render_flat_list && group.children_of_type?(Group.sti_name), posinset: group_index + 1, setsize: groups.size, aria: { label: namespace_row_aria_label(group)}, button_arguments: {data: {"toggle-url": public_send("dashboard_groups_url", { parent_id: group.id, collapse: false, level: 1, posinset: group_index + 1, setsize: groups.size })}}, id: dom_id(group)) do %>
            <%= render NamespaceRow::ContentsComponent.new(
              namespace: group,
              full_name: render_flat_list,
              icon_size: :medium,
            ) %>
          <% end %>
        <% end %>
      <% end %>

      <% if pagy.count.positive? %>
        <div class="flex flex-row-reverse"><%= render Viral::Pagy::PaginationComponent.new(pagy) %></div>
      <% else %>
        <%= render Viral::EmptyStateComponent.new(
          title: t("components.viral.pagy.empty_state.title"),
          description: t("components.viral.pagy.empty_state.description"),
          icon_name: :magnifying_glass,
        ) %>
      <% end %>
    </div>
  <% else %>
    <div class="empty_state_message">
      <%= render Viral::EmptyStateComponent.new(
        icon_name: Group.icon,
        title: empty_title,
        description: empty_description
      ) %>
    </div>
  <% end %>
</div>
