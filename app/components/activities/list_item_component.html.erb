<li class="activity ms-4 mb-4 text-base font-normal wrap-anywhere text-slate-500 dark:text-slate-400">
  <div
    class="
      absolute -inset-s-1.5 mt-1.5 h-3 w-3 rounded-full border border-white bg-slate-500 dark:border-slate-500
      dark:bg-slate-500
    "
  ></div>

  <div class="mb-1 text-sm leading-none font-normal text-slate-500 dark:text-slate-400">
    <%= helpers.local_time(activity[:created_at]) %>
  </div>

  <%= render activity_component %>
</li>
