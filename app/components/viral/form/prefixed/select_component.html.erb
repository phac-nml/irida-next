<div class="flex flex-col rounded-lg border border-slate-300 bg-slate-300 @md:flex-row dark:border-slate-600 dark:bg-slate-600">
  <span
    class="
      inline-flex items-center rounded-t-lg px-3 py-2 font-mono text-sm text-slate-900 @md:rounded-l-lg
      @md:rounded-tr-none dark:text-slate-300
    "
  >
    <%= prefix %>
  </span>

  <%= form.select name,
              options,
              { selected: selected_value },
              class:
                "bg-slate-50 border-none text-slate-900 block flex-1 min-w-0 w-full text-sm p-2.5 dark:bg-slate-700 dark:placeholder-slate-400 dark:text-white focus-visible:z-10 rounded-b-lg @md:rounded-bl-none @md:rounded-r-lg" %>
</div>
