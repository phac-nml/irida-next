<div class="@container workflow-parameter min-w-0">
  <% describedby_ids = [@prefix_id] %>
  <% describedby_ids << @help_text_id if property[:help_text].present? %>
  <% describedby_ids << @error_id if property[:required] %>
  <% grouped = property[:type] == "boolean" || ((property[:format] == "path" || property[:format] == "file-path") && property[:enum].blank?) %>

  <%= content_tag(grouped ? :fieldset : :div, class: "m-0 min-w-0 border-0 p-0") do %>
    <% if grouped %>
      <legend id="<%= @legend_id %>" class="mb-2 block text-sm font-semibold text-[var(--pvc-color-text)]">
        <%= property[:description] %>
        <%= required_indicator if property[:required] %>
      </legend>
    <% else %>
      <%= fields.label name, property[:description], data: { required: property[:required] || nil } %>
    <% end %>

    <div class="workflow-parameter-control">
      <span id="<%= @prefix_id %>" class="workflow-parameter-prefix"><%= format_name_as_arg(name) %></span>

      <% if property[:type] == "boolean" %>
        <% value = instance.present? ? instance["workflow_params"][name.to_s] : property[:default] %>
        <% value = ActiveModel::Type::Boolean.new.cast(value) || false %>
        <div class="workflow-parameter-input flex flex-wrap items-center gap-x-4 gap-y-2">
          <% [true, false].each do |option| %>
            <%= fields.radio_button name, option.to_s,
                                    label: t("components.nextflow.v2.workflow_param_property_component.boolean_options.#{option}"),
                                    checked: value == option,
                                    aria: { describedby: describedby_ids.join(" ") } %>
          <% end %>
        </div>
      <% elsif grouped %>
        <a
          id="<%= fields.field_id(name, "link") %>"
          href="<%= helpers.new_workflow_executions_file_selector_path(
                            file_selector: {
                              pattern: property[:pattern] || ".*",
                              property: name,
                              required: property[:required],
                              attachable_id: @namespace_id,
                              attachable_type: @namespace_type,
                              selected_id: selected_attachment&.id,
                              namespace_id: @namespace_id,
                              help_text: property[:help_text]
                            }
                          ) %>"
          class="workflow-parameter-input workflow-parameter-file"
          aria-labelledby="<%= @legend_id %> <%= fields.field_id(name, "link") %>"
          aria-describedby="<%= describedby_ids.join(" ") %>"
          data-turbo-stream="true"
        >
          <%= selected_attachment&.file&.filename&.to_s || t('components.nextflow.no_selected_file') %>
        </a>
        <%# Hidden inputs can't take aria-required, so workflow validation reads data-required. %>
        <%= fields.hidden_field name,
                            value: selected_attachment&.to_global_id,
                            data: { required: property[:required] ? "true" : nil } %>
      <% else %>
        <%= form_input(fields, name, property, instance, describedby: describedby_ids.join(" ")) %>
      <% end %>
    </div>
  <% end %>

  <% if property[:required] %>
    <%= render Viral::Form::HelpTextComponent.new(id: @error_id, state: :error, classes: "hidden") %>
  <% end %>

  <% if property[:help_text].present? %>
    <p id="<%= help_text_id %>" class="mt-2 text-sm text-[var(--pvc-color-text-muted)]"><%= property[:help_text] %></p>
  <% end %>
</div>
