<section class="mb-6 w-full">
  <div class="flex w-full flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
    <div class="flex min-w-0 flex-1 flex-col gap-3">
      <div class="flex items-start gap-3">
        <% if icon.present? %>
          <div class="mt-1 shrink-0">
            <%= icon %>
          </div>
        <% end %>

        <div class="min-w-0 flex-1">
          <%= render Pathogen::Typography::Heading.new(level: 1, class: "wrap-break-word") do %>
            <%= title %>
          <% end %>
        </div>
      </div>

      <% if subtitle.present? %>
        <div class="<%= icon? ? 'pl-12' : '' %>">
          <%= render Pathogen::Typography::Supporting.new(variant: :muted, class: "wrap-break-word") do %>
            <%= subtitle %>
          <% end %>
        </div>
      <% end %>

      <% if @id %>
        <div class="order-last lg:order-0 <%= icon? ? 'pl-12' : '' %>">
          <div class="inline-block">
            <%= render PuidComponent.new(puid: id) %>
          </div>
        </div>
      <% end %>
    </div>

    <% if buttons? %>
      <div
        class="
          flex w-full flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-2 lg:w-auto lg:shrink-0
          lg:self-start
        "
      >
        <%= buttons %>
      </div>
    <% end %>
  </div>
</section>
