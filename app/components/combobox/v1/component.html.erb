<%= tag.div(
  data: {
    controller: "combobox--v1",
    "combobox--v1-clear-selection-label-value": t("combobox_component.clear_selection"),
    "combobox--v1-no-results-text-value": t("combobox_component.no_results_text"),
    "combobox--v1-show-options-label-value": t("combobox_component.show_options"),
    "combobox--v1-single-result-text-value": t("combobox_component.single_result_text"),
    "combobox--v1-multiple-results-text-value": t("combobox_component.multiple_results_text"),
  },
) do %>
  <%= @form.hidden_field @field,
                     value: @selected_option[:value],
                     id: "#{@combobox_id}_hidden",
                     data: {
                       action: @combobox_arguments.dig(:data, :action),
                       "combobox--v1-target": "hidden",
                     } %>

  <%= render Viral::BaseComponent.new(**combobox_arguments) %>

  <div class="absolute inset-y-0.5 right-0.5 z-10 flex items-center gap-1">
    <%= tag.button(
      type: 'button',
      class: selection_present? ? 'flex' : 'hidden',
      data: {
        "combobox--v1-target": "indicatorClearButton",
        action: "mousedown->combobox--v1#onIndicatorMouseDown click->combobox--v1#onClearClick"
      },
      aria: {
        label: t('combobox_component.clear_selection')
      },
      title: t('combobox_component.clear_selection'),
      tabindex: -1,
      "aria-disabled": combobox_disabled?
    ) do %>
      <%= icon(:x, size: :sm, color: nil) %>
    <% end %>

    <%= tag.button(
      type: 'button',
      class: 'flex',
      data: {
        "combobox--v1-target": "indicatorButton",
        action: "mousedown->combobox--v1#onIndicatorMouseDown click->combobox--v1#onIndicatorClick"
      },
      aria: {
        label: t('combobox_component.show_options')
      },
      title: t('combobox_component.show_options'),
      tabindex: -1,
      "aria-disabled": combobox_disabled?
    ) do %>
      <%= icon(:caret_down, size: :sm, color: nil) %>
    <% end %>
  </div>

  <div data-combobox--v1-target="popup" aria-hidden="true" style="display: none;">
    <%= tag.div(
      id: @listbox_id,
      role: "listbox",
      "aria-label": combobox_arguments[:aria][:label],
      "data-combobox--v1-target": "listbox",
    ) do %>
      <% if options? %>
        <% options.each do |option| %>
          <%= option %>
        <% end %>
      <% else %>
        <%= @listbox_options %>
      <% end %>
    <% end %>

    <div role="status" hidden data-combobox--v1-target="noResults"></div>
  </div>

  <div class="sr-only" aria-live="polite" data-combobox--v1-target="ariaLiveUpdate"></div>
<% end %>
