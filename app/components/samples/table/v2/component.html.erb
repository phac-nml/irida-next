<% if empty_state? %>
  <div class="empty_state_message">
    <%= render Viral::EmptyStateComponent.new(
      title: @empty[:title],
      description: @empty[:description],
      icon_name: Sample.icon,
    ) %>

    <p class="mt-2 text-[length:var(--type-meta)] text-[var(--pvc-color-text-muted)]" data-samples-total>
      <%= t("samples.table_component.counts.samples") %>: <strong>0</strong>
    </p>
  </div>
<% else %>
  <%= render data_grid do |grid| %>
    <% if @pagy %>
      <% grid.with_footer do %>
        <div
          class="
            border-t border-[var(--pvc-color-border)] px-[var(--pvc-data-grid-cell-padding-x)] py-2
            text-[length:var(--type-meta)] text-[var(--pvc-color-text-muted)]
          "
          data-samples-total
        >
          <%= t("samples.table_component.counts.samples") %>: <strong><%= number_with_delimiter(@pagy.count) %></strong>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
