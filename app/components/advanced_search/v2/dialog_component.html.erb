<%= tag.div(
  id: "advanced-search",
  data: {
    action: "viral--dialog:close->advanced-search--v2--dialog#close",
    controller: "advanced-search--v2--dialog",
    "advanced-search--v2--dialog-advanced-search--v2--builder-outlet": "#advanced-search-builder",
    "advanced-search--v2--dialog-open-value": @open,
    "advanced-search--v2--dialog-status-value": @status,
    "advanced-search--v2--dialog-has-errors-value": @search.errors.any?,
    "advanced-search--v2--dialog-confirm-close-text-value": t("components.advanced_search_component.confirm_close_text"),
  },
) do %>
  <%= render Viral::DialogComponent.new(id: 'advanced-search-dialog', size: :large, open: @open) do |dialog| %>
    <% dialog.with_trigger do %>
      <div class="flex w-full grow flex-row" role="group">
        <%= tag.button(**Pathogen::Button.new(
          type: :button,
          tone: :neutral,
          emphasis: :outline,
          block: true,
          class: class_names("focus-visible:z-10", { "rounded-e-none border-e-0": @status }),
          data: {
            "viral--dialog-target": "trigger",
            action: "advanced-search--v2--dialog#renderSearch viral--dialog#open",
          },
        ).html_attributes) do %>
          <%= t("components.advanced_search_component.title") %>
        <% end %>

        <% if @status %>
          <%= render Pathogen::Button.new(
            type: :button,
            tone: :neutral,
            emphasis: :outline,
            icon_only: true,
            text: t("components.advanced_search_component.clear_aria_label"),
            class: "rounded-s-none",
            data: { action: "advanced-search--v2--dialog#clearForm filters#submit" },
          ) do |button| %>
            <% button.with_leading_visual do %>
              <%= icon(:x, size: :sm) %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% dialog.with_header(title: t("components.advanced_search_component.title")) %>

    <%= render AdvancedSearch::V2::BuilderComponent.new(
        form: @form,
        search: @search,
        fields: @fields,
        sample_fields: @sample_fields,
        metadata_fields: @metadata_fields,
      ) %>

    <% dialog.with_secondary_action do %>
      <%= render Pathogen::Button.new(type: :button, tone: :neutral, emphasis: :outline, data: { action: "advanced-search--v2--dialog#clearForm viral--dialog#close filters#submit" }) do %>
        <%= t("components.advanced_search_component.clear_filter_button") %>
      <% end %>
    <% end %>

    <%# The primary_action slot constructs a Viral button; use content slots for both Pathogen actions. %>
    <% dialog.with_secondary_action do %>
      <%= render Pathogen::Button.new(
        type: :button,
        tone: :primary,
        emphasis: :solid,
        data: { action: "viral--dialog#close filters#submit" },
      ) do %>
        <%= t("components.advanced_search_component.apply_filter_button") %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
