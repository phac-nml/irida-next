<%= tag.div(
  id: "advanced-search-builder",
  data: {
    controller: "advanced-search--v2--builder",
    "advanced-search--v2--builder-list-input-outlet": ".list-input",
    "advanced-search--v2--builder-enum-fields-value": json_escape_data(@fields.fetch(:enum_fields, {})),
    "advanced-search--v2--builder-enum-operations-value": json_escape_data(enum_operation_options),
    "advanced-search--v2--builder-operations-value": json_escape_data(@operations),
  },
) do %>
  <div class="space-y-4">
    <p class="text-base leading-relaxed text-slate-500 dark:text-slate-400">
      <%= t("components.advanced_search_component.v2.description") %>
    </p>

    <p class="text-base leading-relaxed text-slate-500 dark:text-slate-400">
      <% if Flipper.enabled?(:advanced_search_metadata_operators) %>
        <%= t("components.advanced_search_component.v2.rules.metadata_operators") %>
      <% else %>
        <%= t("components.advanced_search_component.v2.rules.standard_operators") %>
      <% end %>
    </p>

    <%= helpers.form_error_summary(@form) %>

    <div class="mb-4"><%= render partial: "shared/form/required_field_legend" %></div>

    <div class="space-y-4" data-advanced-search--v2--builder-target="searchGroupsContainer"></div>

    <div class="flex justify-end space-x-2">
      <%= render Viral::ButtonComponent.new(data: { action: "advanced-search--v2--builder#addGroup" }) do %>
        <%= t("components.advanced_search_component.v2.add_group_button") %>
      <% end %>
    </div>

    <template data-advanced-search--v2--builder-target="searchGroupsTemplate">
      <% @search.groups.each_with_index do |group, group_index| %>
        <%= render AdvancedSearch::V2::GroupComponent.new(
          form: @form,
          group: group,
          group_index: group_index,
          group_number: group_index + 1,
          show_remove_group_button: @search.groups.count > 1,
          fields: @fields,
          operations: @operations,
        ) %>
      <% end %>
    </template>
  </div>

  <template data-advanced-search--v2--builder-target="listValueTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <% condition = @search_condition_class.new(field: "__FIELD_PLACEHOLDER__", operator: "in") %>

      <%= group_form.fields_for :conditions, condition, child_index: "CONDITION_INDEX_PLACEHOLDER" do |conditions_form| %>
        <%= render AdvancedSearch::V2::ValueComponent.new(
          conditions_form: conditions_form,
          group_index: "GROUP_INDEX_PLACEHOLDER",
          condition: condition,
          condition_index: "CONDITION_INDEX_PLACEHOLDER",
        ) %>
      <% end %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="listSelectValueTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <% condition = @search_condition_class.new(field: "__FIELD_PLACEHOLDER__", operator: "in") %>

      <%= group_form.fields_for :conditions, condition, child_index: "CONDITION_INDEX_PLACEHOLDER" do |conditions_form| %>
        <%= render AdvancedSearch::V2::ValueComponent.new(
          conditions_form: conditions_form,
          group_index: "GROUP_INDEX_PLACEHOLDER",
          condition: condition,
          condition_index: "CONDITION_INDEX_PLACEHOLDER",
          options: [],
        ) %>
      <% end %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="valueTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <% condition = @search_condition_class.new(field: "__FIELD_PLACEHOLDER__", operator: "=") %>

      <%= group_form.fields_for :conditions, condition, child_index: "CONDITION_INDEX_PLACEHOLDER" do |conditions_form| %>
        <%= render AdvancedSearch::V2::ValueComponent.new(
          conditions_form: conditions_form,
          group_index: "GROUP_INDEX_PLACEHOLDER",
          condition: condition,
          condition_index: "CONDITION_INDEX_PLACEHOLDER",
        ) %>
      <% end %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="betweenValueTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <% condition = @search_condition_class.new(field: "__FIELD_PLACEHOLDER__", operator: "between") %>

      <%= group_form.fields_for :conditions, condition, child_index: "CONDITION_INDEX_PLACEHOLDER" do |conditions_form| %>
        <%= render AdvancedSearch::V2::ValueComponent.new(
          conditions_form: conditions_form,
          group_index: "GROUP_INDEX_PLACEHOLDER",
          condition: condition,
          condition_index: "CONDITION_INDEX_PLACEHOLDER",
        ) %>
      <% end %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="selectValueTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <% condition = @search_condition_class.new(field: "__FIELD_PLACEHOLDER__", operator: "=") %>

      <%= group_form.fields_for :conditions, condition, child_index: "CONDITION_INDEX_PLACEHOLDER" do |conditions_form| %>
        <%= render AdvancedSearch::V2::ValueComponent.new(
          conditions_form: conditions_form,
          group_index: "GROUP_INDEX_PLACEHOLDER",
          condition: condition,
          condition_index: "CONDITION_INDEX_PLACEHOLDER",
          options: [],
        ) %>
      <% end %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="conditionTemplate">
    <%= @form.fields_for :groups, @search_group_class.new, child_index: "GROUP_INDEX_PLACEHOLDER" do |group_form| %>
      <%= render AdvancedSearch::V2::ConditionComponent.new(
        groups_form: group_form,
        group_index: "GROUP_INDEX_PLACEHOLDER",
        condition: @search_condition_class.new,
        condition_index: "CONDITION_INDEX_PLACEHOLDER",
        condition_number: "CONDITION_LEGEND_INDEX_PLACEHOLDER",
        fields: @fields,
        operations: @operations,
      ) %>
    <% end %>
  </template>

  <template data-advanced-search--v2--builder-target="groupTemplate">
    <%= render AdvancedSearch::V2::GroupComponent.new(
      form: @form,
      group: @search_group_class.new,
      group_index: "GROUP_INDEX_PLACEHOLDER",
      group_number: "GROUP_LEGEND_INDEX_PLACEHOLDER",
      show_remove_group_button: true,
      fields: @fields,
      operations: @operations,
    ) %>
  </template>

  <template data-advanced-search--v2--builder-target="emptySearchTemplate">
    <%= @form.hidden_field :groups_attributes, value: '' %>
  </template>
<% end %>
