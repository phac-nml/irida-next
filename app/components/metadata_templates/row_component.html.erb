<%= render Viral::BaseComponent.new(**row_arguments) do %>
  <% @columns.each_with_index do |column, index| %>
    <%= render_cell(
                tag: 'td',
                scope: nil,
                classes: class_names('px-3 py-3', '2xl:sticky left-0 bg-slate-50 dark:bg-slate-900': index.zero?)
              ) do %>
      <%= metadata_template_cell_content(column) %>
    <% end %>
  <% end %>

  <% if @renders_row_actions %>
    <%= render_cell(
                tag: 'td',
                classes: 'flex space-x-2 px-3 py-3 justify-end'
              ) do %>
      <% if @row_actions.key?(:update_metadata_templates) %>
        <%= pathogen_button_to t('common.actions.edit'),
        edit_path,
        data: {
          controller: "viral--dialog-trigger",
          "viral--dialog-trigger-target": "button",
          action: "viral--dialog-trigger#open",
          "viral--dialog-trigger-viral--dialog-outlet": ".dialog",
          turbo_frame: "metadata_template_modal",
          turbo_stream: true,
        },
        method: :get,
        aria: {
          label:
            (
              t(
                :"metadata_templates.table_component.edit_aria_label",
                template_name: @metadata_template.name,
              )
            ),
        },
        tone: :neutral,
        emphasis: :outline,
        size: :small %>
      <% end %>

      <% if @row_actions.key?(:destroy_metadata_templates) %>
        <%= pathogen_button_to t('common.actions.delete'),
        individual_path,
        data: {
          turbo_method: :delete,
          turbo_confirm:
            (
              t(
                :"metadata_templates.table_component.remove_confirmation",
                template_name: @metadata_template.name,
              )
            ),
        },
        method: :delete,
        aria: {
          label:
            (
              t(
                :"metadata_templates.table_component.remove_aria_label",
                template_name: @metadata_template.name,
              )
            ),
        },
        tone: :danger,
        emphasis: :outline,
        size: :small %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
